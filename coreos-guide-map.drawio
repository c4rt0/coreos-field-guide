        <mxCell id="13" value="Token-efficient use: read one ELI15 + one technical guide + a relevant note, not the whole repository. This guide gives context; the target source branch is authoritative." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cbd5e1;fontColor=#334155;fontSize=18;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
