        <mxCell id="6" value="&lt;b&gt;Technical guide&lt;/b&gt;&lt;br&gt;Workflow, tests, and caveats&lt;br&gt;Focused issue notes as needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1f2937;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
