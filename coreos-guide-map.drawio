<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.7.0" type="device">
  <diagram id="coreos-guide-map" name="CoreOS Issue Context Flow">
    <mxGraphModel dx="1180" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;CoreOS issue work, with reusable context&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:18px;font-weight:normal&quot;&gt;Built from my CoreOS work. Fork it, then load only what this issue needs.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#172554;fontColor=#ffffff;fontSize=26;fontFamily=Arial;align=left;verticalAlign=middle;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;1. Bring the issue&lt;/b&gt;&lt;br&gt;Target repo and branch/release&lt;br&gt;Architecture, failure, and logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;2. Choose the project&lt;/b&gt;&lt;br&gt;Use the issue map&lt;br&gt;Open only the relevant guide" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=19;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
