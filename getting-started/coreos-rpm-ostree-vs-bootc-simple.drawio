        <mxCell id="surprise_title" value="Deployment and storage backends are related, not identical" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#7B1FA2;" vertex="1" parent="surprise_bg">
          <mxGeometry x="100" y="15" width="880" height="35" as="geometry" />
        </mxCell>

        <mxCell id="surprise_desc" value="bootc defaults to OSTree and also supports composefs.&#xa;Deployment names do not necessarily represent separate disk partitions." style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#555555;" vertex="1" parent="surprise_bg">
          <mxGeometry x="120" y="55" width="820" height="40" as="geometry" />
        </mxCell>

        <!-- Three shared things -->
        <mxCell id="shared1" value="Staged deployments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="surprise_bg">
          <mxGeometry x="40" y="110" width="280" height="45" as="geometry" />
        </mxCell>
        <mxCell id="shared1_desc" value="Stage a new OS state; activate it at boot.&#xa;This does not imply separate A/B partitions." style="text;html=1;align=center;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="surprise_bg">
          <mxGeometry x="35" y="158" width="290" height="30" as="geometry" />
        </mxCell>

        <mxCell id="shared2" value="Rollback is explicit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="surprise_bg">
          <mxGeometry x="370" y="110" width="280" height="45" as="geometry" />
        </mxCell>
        <mxCell id="shared2_desc" value="Select a prior deployment or use the OS&#xa;rollback command; automatic rollback varies." style="text;html=1;align=center;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="surprise_bg">
          <mxGeometry x="365" y="158" width="290" height="30" as="geometry" />
        </mxCell>

        <mxCell id="shared3" value="Read-only is not tamper-proof" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7B1FA2;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="surprise_bg">
          <mxGeometry x="700" y="110" width="280" height="45" as="geometry" />
        </mxCell>
        <mxCell id="shared3_desc" value="OS paths are normally read-only, but this&#xa;alone does not provide integrity protection." style="text;html=1;align=center;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="surprise_bg">
          <mxGeometry x="695" y="158" width="290" height="30" as="geometry" />
        </mxCell>

