        <mxCell id="title" value="Two Ways to Manage an Image-Based Operating System" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="1080" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="rpm-ostree (RPM-aware deployments) and bootc (bootable OCI images)" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#888888;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="60" width="1080" height="30" as="geometry" />
