        <!-- Benefits callout -->
        <mxCell id="new_benefit" value="Benefits: OCI tooling and image workflows,&#xa;with OS-specific integration requirements." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=12;fontStyle=2;verticalAlign=middle;fontColor=#2E7D32;" vertex="1" parent="new_bg">
