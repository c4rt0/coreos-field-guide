        <mxCell id="analogy_title" value="Two runtime managers; build recipes can overlap" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#F57F17;" vertex="1" parent="analogy_bg">
          <mxGeometry x="70" y="5" width="940" height="30" as="geometry" />
        </mxCell>
        <mxCell id="analogy_old" value="rpm-ostree = RPM-aware composition and deployment management.&#xa;Local RPM layering and Containerfile-derived OCI images are possible." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#1565C0;fontStyle=0;" vertex="1" parent="analogy_bg">
          <mxGeometry x="20" y="35" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="analogy_new" value="bootc = Manage bootc-compatible OCI OS images.&#xa;The image contract matters, not which build-input format was used." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#2E7D32;fontStyle=0;" vertex="1" parent="analogy_bg">
          <mxGeometry x="560" y="35" width="520" height="40" as="geometry" />
