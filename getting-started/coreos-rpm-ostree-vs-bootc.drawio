              <mxPoint x="105" y="720" />
              <mxPoint x="260" y="720" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="o_rollback_label" value="Select prior deployment explicitly.&#xa;Automatic rollback is not guaranteed." style="text;html=1;align=left;verticalAlign=top;fontSize=9;fontColor=#388E3C;fontStyle=2;" vertex="1" parent="ostree_lane">
          <mxGeometry x="350" y="660" width="210" height="30" as="geometry" />
        </mxCell>

        <!-- ==================== RIGHT: BOOTC MODEL ==================== -->
        <mxCell id="bootc_lane" value="Example: bootc management" style="swimlane;pointerEvents=0;html=1;startSize=35;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=16;fontStyle=1;rounded=1;swimlaneLine=1;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="660" y="90" width="580" height="780" as="geometry" />
        </mxCell>

        <!-- Config -->
        <mxCell id="b_phase1" value="1. DEFINE" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="bootc_lane">
          <mxGeometry x="10" y="45" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="b_containerfile" value="Containerfile (example)" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=center;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=12;fontStyle=1;" vertex="1" parent="bootc_lane">
          <mxGeometry x="30" y="70" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b_containerfile_desc" value="A common OCI recipe, not a requirement.&#xa;Manifest-based builders can also&#xa;produce bootc-compatible OCI images." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="bootc_lane">
          <mxGeometry x="270" y="65" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- Build -->
        <mxCell id="b_phase2" value="2. BUILD" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="bootc_lane">
          <mxGeometry x="10" y="135" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="b_podman" value="podman build /&#xa;buildah" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="bootc_lane">
          <mxGeometry x="30" y="160" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b_podman_desc" value="Use standard OCI build tools, but the&#xa;base image must follow bootc's image&#xa;contract and distribution requirements." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="bootc_lane">
          <mxGeometry x="230" y="155" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b_arrow1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D32;" edge="1" parent="bootc_lane" source="b_containerfile" target="b_podman">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- OCI image -->
        <mxCell id="b_phase3" value="3. OUTPUT" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="bootc_lane">
          <mxGeometry x="10" y="225" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="b_oci" value="OCI Container Image" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=12;fontStyle=1;verticalAlign=middle;size=12;" vertex="1" parent="bootc_lane">
          <mxGeometry x="30" y="250" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="b_oci_desc" value="A bootc-compatible OS image with the&#xa;kernel and required boot integration.&#xa;The image contract includes the&#xa;containers.bootc=1 compatibility label." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="bootc_lane">
          <mxGeometry x="230" y="245" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b_arrow2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D32;" edge="1" parent="bootc_lane" source="b_podman" target="b_oci">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Custom images -->
        <mxCell id="b_custom" value="Custom Images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="bootc_lane">
          <mxGeometry x="300" y="320" width="130" height="35" as="geometry" />
        </mxCell>
        <mxCell id="b_custom_desc" value="FROM a compatible base image&#xa;Use its package-build guidance" style="text;html=1;align=center;verticalAlign=top;fontSize=9;fontColor=#555555;fontStyle=2;" vertex="1" parent="bootc_lane">
          <mxGeometry x="290" y="355" width="160" height="25" as="geometry" />
        </mxCell>
        <mxCell id="b_arrow2b" value="derive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D32;dashed=1;fontSize=9;fontColor=#888888;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="bootc_lane" source="b_oci" target="b_custom">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="210" y="337.5" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- Distribute -->
        <mxCell id="b_phase4" value="4. DISTRIBUTE" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="bootc_lane">
          <mxGeometry x="10" y="385" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="b_registry" value="Container Registry&#xa;(quay.io, Docker Hub, etc.)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontStyle=1;verticalAlign=middle;size=12;" vertex="1" parent="bootc_lane">
          <mxGeometry x="30" y="410" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="b_registry_desc" value="OCI image source, such as a registry.&#xa;No separate OSTree server is needed&#xa;for this image transport." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="bootc_lane">
          <mxGeometry x="270" y="410" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b_arrow3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D32;" edge="1" parent="bootc_lane" source="b_oci" target="b_registry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Update client -->
        <mxCell id="b_phase5" value="5. UPDATE" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="bootc_lane">
          <mxGeometry x="10" y="480" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="b_bootc_cmd" value="bootc upgrade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="bootc_lane">
          <mxGeometry x="30" y="505" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b_update_desc" value="Pulls the tracked OCI image and stages&#xa;an update. Automatic checks are a&#xa;separate policy; upstream provides an&#xa;optional service/timer for distributions." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="bootc_lane">
          <mxGeometry x="230" y="495" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b_arrow4" value="pulls image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D32;fontSize=9;fontColor=#888888;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="bootc_lane" source="b_bootc_cmd" target="b_registry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Deploy -->
        <mxCell id="b_phase6" value="6. DEPLOY" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="bootc_lane">
          <mxGeometry x="10" y="570" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="b_deploy" value="OSTree default /&#xa;composefs backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="bootc_lane">
          <mxGeometry x="30" y="595" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b_deploy_desc" value="OSTree is the default backend; bootc&#xa;also supports composefs. Deployments&#xa;are staged for activation, but need not&#xa;map to separate A/B partitions." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="bootc_lane">
          <mxGeometry x="230" y="585" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b_arrow5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D32;" edge="1" parent="bootc_lane" source="b_bootc_cmd" target="b_deploy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- A/B deployments (same!) -->
        <mxCell id="b_ab" value="Current deployment&#xa;(booted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=10;fontStyle=0;verticalAlign=middle;" vertex="1" parent="bootc_lane">
          <mxGeometry x="40" y="660" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b_ab2" value="New deployment&#xa;(pending activation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;fontStyle=0;verticalAlign=middle;" vertex="1" parent="bootc_lane">
          <mxGeometry x="190" y="660" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b_reboot" value="reboot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F9A825;fontSize=9;fontColor=#888888;strokeWidth=2;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="bootc_lane" source="b_ab" target="b_ab2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
