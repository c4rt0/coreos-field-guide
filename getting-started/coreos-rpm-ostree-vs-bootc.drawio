<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.0.4">
  <diagram name="rpm-ostree vs bootc" id="ostree-vs-bootc">
    <mxGraphModel dx="2200" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== TITLE ==================== -->
        <mxCell id="title" value="rpm-ostree and bootc: OS image-management models" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="150" y="10" width="970" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Build input, transport, storage backend, and update controller are separate choices" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#888888;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="150" y="55" width="970" height="25" as="geometry" />
        </mxCell>

        <!-- ==================== LEFT: RPM-OSTREE MODEL ==================== -->
        <mxCell id="ostree_lane" value="Example: rpm-ostree management" style="swimlane;pointerEvents=0;html=1;startSize=35;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=16;fontStyle=1;rounded=1;swimlaneLine=1;fontColor=#1565C0;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="580" height="780" as="geometry" />
        </mxCell>

        <!-- Config -->
        <mxCell id="o_phase1" value="1. DEFINE" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1565C0;" vertex="1" parent="ostree_lane">
          <mxGeometry x="10" y="45" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="o_treefile" value="Treefile / manifest (example)" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=center;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;" vertex="1" parent="ostree_lane">
          <mxGeometry x="30" y="70" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o_treefile_desc" value="RPM packages, repositories, OS settings.&#xa;Can also feed a Containerfile build.&#xa;Build input does not fix the runtime manager." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="ostree_lane">
          <mxGeometry x="270" y="65" width="290" height="50" as="geometry" />
        </mxCell>

        <!-- Build -->
        <mxCell id="o_phase2" value="2. BUILD" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1565C0;" vertex="1" parent="ostree_lane">
          <mxGeometry x="10" y="135" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="o_cosa" value="COSA&#xa;(coreos-assembler)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="ostree_lane">
          <mxGeometry x="30" y="160" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o_cosa_desc" value="COSA orchestrates image builds.&#xa;Tree composition or manifest-driven&#xa;Containerfile/Buildah builds are possible." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="ostree_lane">
          <mxGeometry x="230" y="155" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o_arrow1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1565C0;" edge="1" parent="ostree_lane" source="o_treefile" target="o_cosa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- OSTree commit -->
        <mxCell id="o_phase3" value="3. OUTPUT" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1565C0;" vertex="1" parent="ostree_lane">
          <mxGeometry x="10" y="225" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="o_commit" value="OSTree / OCI OS Content" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;verticalAlign=middle;size=12;" vertex="1" parent="ostree_lane">
          <mxGeometry x="30" y="250" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="o_commit_desc" value="Content-addressed OS filesystem content.&#xa;Unchanged objects/layers can be reused;&#xa;transfer granularity depends on transport." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="ostree_lane">
          <mxGeometry x="230" y="245" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o_arrow2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1565C0;" edge="1" parent="ostree_lane" source="o_cosa" target="o_commit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Disk images -->
        <mxCell id="o_disk" value="Disk Images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="ostree_lane">
          <mxGeometry x="300" y="320" width="130" height="35" as="geometry" />
        </mxCell>
        <mxCell id="o_disk_desc" value="qcow2, raw, ISO, AMI..." style="text;html=1;align=center;verticalAlign=top;fontSize=9;fontColor=#555555;fontStyle=2;" vertex="1" parent="ostree_lane">
          <mxGeometry x="295" y="355" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="o_arrow2b" value="also&#xa;produces" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1565C0;dashed=1;fontSize=9;fontColor=#888888;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="ostree_lane" source="o_commit" target="o_disk">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="210" y="337.5" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- Distribute -->
        <mxCell id="o_phase4" value="4. DISTRIBUTE" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1565C0;" vertex="1" parent="ostree_lane">
          <mxGeometry x="10" y="385" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="o_repo" value="OSTree Remote /&#xa;OCI Image Source" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;fontStyle=1;verticalAlign=middle;size=12;" vertex="1" parent="ostree_lane">
          <mxGeometry x="30" y="410" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="o_repo_desc" value="Current FCOS defaults to OCI transport.&#xa;Older/custom hosts can use OSTree remotes.&#xa;No dedicated OSTree server is required." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="ostree_lane">
          <mxGeometry x="270" y="415" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o_arrow3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1565C0;" edge="1" parent="ostree_lane" source="o_commit" target="o_repo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Update client -->
        <mxCell id="o_phase5" value="5. UPDATE" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1565C0;" vertex="1" parent="ostree_lane">
          <mxGeometry x="10" y="480" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="o_zincati" value="Zincati" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="ostree_lane">
          <mxGeometry x="30" y="505" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="o_cincy" value="Cincinnati" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="ostree_lane">
          <mxGeometry x="150" y="505" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="o_update_desc" value="FCOS: Zincati asks Cincinnati which&#xa;updates are permitted, then coordinates&#xa;staging with rpm-ostree. Other&#xa;rpm-ostree hosts use their own update&#xa;controllers and policies." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="ostree_lane">
          <mxGeometry x="270" y="495" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="o_arrow4a" value="checks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1565C0;fontSize=9;fontColor=#888888;" edge="1" parent="ostree_lane" source="o_zincati" target="o_cincy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o_arrow4b" value="fetch via&#xa;rpm-ostree" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1565C0;fontSize=9;fontColor=#888888;exitX=0.95;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="ostree_lane" source="o_zincati" target="o_repo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Deploy -->
        <mxCell id="o_phase6" value="6. DEPLOY" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1565C0;" vertex="1" parent="ostree_lane">
          <mxGeometry x="10" y="570" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="o_deploy" value="rpm-ostree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="ostree_lane">
          <mxGeometry x="30" y="595" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="o_deploy_desc" value="Creates a bootable deployment (tree),&#xa;not necessarily an A/B partition. Reboot&#xa;selects it; the previous deployment may&#xa;remain available for explicit recovery." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="ostree_lane">
          <mxGeometry x="230" y="585" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o_arrow5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1565C0;" edge="1" parent="ostree_lane" source="o_zincati" target="o_deploy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- A/B deployments -->
        <mxCell id="o_ab" value="Current deployment&#xa;(booted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=10;fontStyle=0;verticalAlign=middle;" vertex="1" parent="ostree_lane">
          <mxGeometry x="40" y="660" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="o_ab2" value="New deployment&#xa;(pending activation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;fontStyle=0;verticalAlign=middle;" vertex="1" parent="ostree_lane">
          <mxGeometry x="190" y="660" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="o_reboot" value="reboot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F9A825;fontSize=9;fontColor=#888888;strokeWidth=2;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="ostree_lane" source="o_ab" target="o_ab2">
          <mxGeometry relative="1" as="geometry">
