<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" compressed="false">
  <diagram id="issue-investigation" name="CoreOS Issue Lifecycle Boundaries">
    <mxGraphModel dx="1200" dy="500" grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1200" pageHeight="500" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title label -->
        <mxCell id="title" value="Follow the artifact to the first failing boundary" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontStyle=3;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="800" height="40" as="geometry" />
        </mxCell>

        <!-- 1. Configuration and inputs -->
        <mxCell id="step1" value="Configuration&#xa;and inputs&#xa;&#xa;branch, packages, build args" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#172b4d;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="210" height="100" as="geometry" />
        </mxCell>

        <!-- 2. Compose / image build -->
        <mxCell id="step2" value="Compose /&#xa;image build&#xa;&#xa;revision, digest, logs" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#263b23;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="270" y="90" width="210" height="100" as="geometry" />
        </mxCell>

        <!-- 3. Test execution -->
        <mxCell id="step3" value="Test&#xa;execution&#xa;&#xa;source, binary, RPM, or image" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#594300;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="90" width="210" height="100" as="geometry" />
        </mxCell>

        <!-- 4. Publication -->
        <mxCell id="step4" value="Publication&#xa;&#xa;digest, metadata, signing" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#432874;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="770" y="90" width="210" height="100" as="geometry" />
        </mxCell>

        <!-- 5. Installed system -->
        <mxCell id="step5" value="Installed&#xa;system&#xa;&#xa;OS version, update path" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#67000d;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1020" y="90" width="210" height="100" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#46556b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#46556b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#46556b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#46556b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Note box -->
        <mxCell id="note" value="Compare failing run with known-good only after aligning&#xa;release, architecture, config, and source revision" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontStyle=2;fontColor=#666666;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="230" width="700" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
