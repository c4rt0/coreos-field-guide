<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.0.4">
  <diagram name="TMT Test Structure" id="tmt-structure">
    <!-- Bootupd metadata and source/RPM paths:
         https://github.com/coreos/bootupd/tree/main/tests/tmt
         https://github.com/coreos/bootupd/blob/main/tests/core/core.fmf
         https://github.com/coreos/bootupd/blob/main/.github/workflows/tmt-tests.yml -->
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="bootupd TMT Smoke Tests (Implemented Upstream)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="950" height="40" as="geometry" />
        </mxCell>

        <!-- LEFT SIDE: The Files -->
        <mxCell id="files_group" value="Existing bootupd Metadata" style="swimlane;html=1;pointerEvents=0;startSize=30;fillColor=#E8F5E9;strokeColor=#82b366;fontSize=14;fontStyle=1;rounded=1;swimlaneLine=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="380" height="440" as="geometry" />
        </mxCell>

        <!-- .fmf/version -->
        <mxCell id="fmf_version" value=".fmf/version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#039BE5;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="files_group">
          <mxGeometry x="20" y="45" width="340" height="35" as="geometry" />
        </mxCell>
        <mxCell id="fmf_desc" value="Contains &quot;1&quot;: marks the FMF metadata tree root&#xa;and its format version. It does not trigger CI by itself." style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#555555;" vertex="1" parent="files_group">
          <mxGeometry x="25" y="82" width="340" height="40" as="geometry" />
        </mxCell>

        <!-- smoke.fmf -->
        <mxCell id="smoke_fmf" value="tests/tmt/plans/smoke.fmf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="files_group">
          <mxGeometry x="20" y="130" width="340" height="35" as="geometry" />
        </mxCell>
        <mxCell id="smoke_desc" value="The PLAN discovers tests tagged smoke and executes them.&#xa;It inherits prepare metadata from the parent main.fmf." style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#555555;" vertex="1" parent="files_group">
          <mxGeometry x="25" y="167" width="310" height="40" as="geometry" />
        </mxCell>

        <!-- main.fmf -->
        <mxCell id="main_fmf" value="tests/tmt/plans/main.fmf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="files_group">
          <mxGeometry x="20" y="215" width="340" height="35" as="geometry" />
        </mxCell>
        <mxCell id="main_desc" value="Inherited PREPARE metadata selects the binary directory.&#xa;use_built_from_src=true: locate target/release/bootupd.&#xa;Otherwise: install bootupd and use /usr/libexec.&#xa;Writes BOOTUPD_BIN_DIR to /tmp/bootupd_bin_dir." style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#555555;" vertex="1" parent="files_group">
          <mxGeometry x="25" y="252" width="310" height="70" as="geometry" />
        </mxCell>

        <!-- core.fmf -->
        <mxCell id="core_fmf" value="tests/core/core.fmf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="files_group">
          <mxGeometry x="20" y="335" width="340" height="35" as="geometry" />
        </mxCell>
        <mxCell id="core_desc" value="Loads /tmp/bootupd_bin_dir and runs:&#xa;&quot;${BOOTUPD_BIN_DIR}/bootupd&quot; --version&#xa;This is a version smoke check, not full behavior coverage." style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#555555;" vertex="1" parent="files_group">
          <mxGeometry x="25" y="372" width="310" height="40" as="geometry" />
        </mxCell>

        <!-- RIGHT SIDE: How TMT Runs -->
        <mxCell id="run_group" value="What Happens When TMT Runs" style="swimlane;html=1;pointerEvents=0;startSize=30;fillColor=#F3E5F5;strokeColor=#9673a6;fontSize=14;fontStyle=1;rounded=1;swimlaneLine=0;" vertex="1" parent="1">
          <mxGeometry x="470" y="70" width="510" height="440" as="geometry" />
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="r1_num" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#9673a6;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="run_group">
          <mxGeometry x="470" y="45" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="TMT loads metadata from the marked FMF tree root" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;" vertex="1" parent="run_group">
          <mxGeometry x="60" y="45" width="390" height="35" as="geometry" />
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="r2_num" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#9673a6;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="run_group">
          <mxGeometry x="470" y="100" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="Selects smoke.fmf with inherited main.fmf preparation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;" vertex="1" parent="run_group">
          <mxGeometry x="60" y="100" width="390" height="35" as="geometry" />
        </mxCell>

        <!-- Step 3 -->
        <mxCell id="r3_num" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#9673a6;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="run_group">
          <mxGeometry x="470" y="155" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="Discovers tests/core/core.fmf using the smoke tag filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;" vertex="1" parent="run_group">
          <mxGeometry x="60" y="155" width="390" height="35" as="geometry" />
        </mxCell>

        <!-- Step 4 -->
        <mxCell id="r4_num" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#9673a6;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="run_group">
          <mxGeometry x="470" y="210" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="After provisioning, PREPARE sets BOOTUPD_BIN_DIR:&#xa;source-built binary or installed RPM, according to context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;" vertex="1" parent="run_group">
          <mxGeometry x="60" y="205" width="390" height="45" as="geometry" />
        </mxCell>

        <!-- Step 5 -->
        <mxCell id="r5_num" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#9673a6;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="run_group">
          <mxGeometry x="470" y="275" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="Executes the selected bootupd binary with --version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673a6;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="run_group">
          <mxGeometry x="60" y="275" width="390" height="35" as="geometry" />
        </mxCell>

        <!-- Result -->
        <mxCell id="r6_pass" value="Exit 0 = PASS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="run_group">
          <mxGeometry x="60" y="340" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r6_fail" value="Exit non-zero = FAIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="run_group">
          <mxGeometry x="260" y="340" width="190" height="40" as="geometry" />
        </mxCell>

        <!-- Arrows between steps -->
        <mxCell id="re1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673a6;" edge="1" parent="run_group" source="r1" target="r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673a6;" edge="1" parent="run_group" source="r2" target="r3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673a6;" edge="1" parent="run_group" source="r3" target="r4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673a6;" edge="1" parent="run_group" source="r4" target="r5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re5a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="run_group" source="r5" target="r6_pass">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re5b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="run_group" source="r5" target="r6_fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Connecting arrows: files -> execution -->
        <mxCell id="c1" value="marks root" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#999999;fontSize=10;fontColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fmf_version" target="r1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="445" y="132" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c2" value="used by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#999999;fontSize=10;fontColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="smoke_fmf" target="r2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="445" y="217" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c3" value="used by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#999999;fontSize=10;fontColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="main_fmf" target="r4">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="445" y="297" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c4" value="runs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#999999;fontSize=10;fontColor=#999999;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="core_fmf" target="r5">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="445" y="422" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Bottom note -->
        <mxCell id="bottom_note" value="Implemented upstream; repository layouts vary.&#xa;bootupd GitHub Actions defaults to source mode; Packit tests the PR-built RPM in package mode.&#xa;Downstream gating needs separate CI/policy integration. A passing smoke check is not package approval." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="530" width="950" height="70" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
