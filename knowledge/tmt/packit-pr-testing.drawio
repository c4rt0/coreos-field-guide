<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.0.4">
  <diagram name="Packit PR Testing" id="packit-flow">
    <!-- Public config and workflow sources are listed in packit.md.
         https://github.com/coreos/bootupd/blob/main/.packit.yaml
         https://github.com/coreos/console-login-helper-messages/blob/main/.packit.yaml -->
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Packit PR RPM Tests: Separate from Source Tests" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="950" height="40" as="geometry" />
        </mxCell>

        <!-- Subtitle: The Problem -->
        <mxCell id="problem_title" value="Check Package Provenance" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="problem" value="TMT does not automatically rebuild PR source: the workflow and plan select the artifact.&#xa;CLHM GitHub Actions installs a distribution RPM; bootupd GitHub Actions builds from source by default.&#xa;Packit adds a separate check of an RPM built from the PR, using the configured TMT smoke plan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="950" height="70" as="geometry" />
        </mxCell>

        <!-- Subtitle: The Solution -->
        <mxCell id="solution_title" value="The Packit RPM Path" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="30" y="170" width="250" height="30" as="geometry" />
        </mxCell>

        <!-- Flow -->
        <!-- Step 1: Developer opens PR -->
        <mxCell id="s1_num" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="220" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="Developer opens&#xa;a Pull Request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="215" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s1_desc" value="e.g. fixes a bug&#xa;in bootupd" style="text;html=1;align=center;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="85" y="270" width="100" height="20" as="geometry" />
        </mxCell>

        <!-- Step 2: Packit sees PR -->
        <mxCell id="s2_num" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="180" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Packit bot&#xa;sees the PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="215" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2_desc" value="Reads .packit.yaml&#xa;to know what to do" style="text;html=1;align=center;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="325" y="270" width="140" height="20" as="geometry" />
        </mxCell>

        <!-- Arrow 1->2 -->
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 3: Copr build -->
        <mxCell id="s3_num" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FF9800;strokeColor=#FF9800;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="340" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Builds RPM in Copr&#xa;from the PR's code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="330" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3_desc" value="Uses the PR source and in-tree spec.&#xa;bootupd: contrib/packaging/bootupd.spec&#xa;(cargo xtask also prepares packaging).&#xa;CLHM: rpm/console-login-helper-&#xa;messages.spec (no spec download)." style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="70" y="400" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- Arrow 2->3 -->
        <mxCell id="e23" value="copr_build job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF9800;fontSize=10;fontColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="550" y="240" />
              <mxPoint x="550" y="310" />
              <mxPoint x="160" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step 4: Testing Farm -->
        <mxCell id="s4_num" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FF9800;strokeColor=#FF9800;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="270" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="Sends RPM to&#xa;Testing Farm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="350" y="330" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s4_desc" value="Testing Farm provisions a guest&#xa;and makes the Copr build available.&#xa;The selected TMT plan prepares&#xa;and executes the package tests." style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="350" y="395" width="210" height="60" as="geometry" />
        </mxCell>

        <!-- Arrow 3->4 -->
        <mxCell id="e34" value=".rpm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF9800;fontSize=10;fontColor=#666666;fontStyle=2;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 5: TMT runs -->
        <mxCell id="s5_num" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#9673a6;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="295" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="TMT runs our&#xa;smoke test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673a6;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="630" y="330" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s5_desc" value="Implemented upstream smoke checks:&#xa;bootupd runs its binary with a version flag;&#xa;CLHM queries installed package presence.&#xa;Coverage is limited to those checks." style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="630" y="395" width="270" height="60" as="geometry" />
        </mxCell>

        <!-- Arrow 4->5 -->
        <mxCell id="e45" value="tests job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;fontSize=10;fontColor=#666666;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 6: Results on PR -->
        <mxCell id="s6_num" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#82b366;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="180" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="Results posted&#xa;on the PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="630" y="215" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- Arrow 5->6 -->
        <mxCell id="e56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Pass/Fail indicators -->
        <mxCell id="pass_indicator" value="PASS: configured&#xa;checks succeeded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="830" y="200" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fail_indicator" value="FAIL: investigate code,&#xa;packaging, or test setup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="830" y="250" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ep" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="pass_indicator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="fail_indicator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Key insight box -->
        <mxCell id="insight" value="KEY DIFFERENCE: Packit tests an installed PR-built RPM.&#xa;Source tests and distribution-package tests answer different questions.&#xa;Passing a smoke test is not complete functional coverage&#xa;or automatic downstream package approval." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82b366;fontSize=11;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="490" width="530" height="90" as="geometry" />
        </mxCell>

        <!-- GH Actions comparison -->
        <mxCell id="compare_title" value="GitHub Actions is a Separate Path" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="600" y="490" width="380" height="30" as="geometry" />
        </mxCell>
        <mxCell id="compare" value="bootupd GHA: source-built binary by default; optional RPM mode.&#xa;CLHM GHA: distribution RPM + package-presence check.&#xa;Packit: PR-built RPM + configured smoke tests.&#xa;See packit.md for public sources." style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="600" y="530" width="380" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
