<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" compressed="false">
  <diagram id="fix-build" name="fix-build Recovery Flow">
    <mxGraphModel dx="900" dy="680" grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="900" pageHeight="680" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Recovery flow -->
        <mxCell id="lane" value="fix-build recovery" style="swimlane;startSize=35;horizontal=1;rounded=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;fontFamily=Arial;fontSize=20;fontStyle=1;align=left;spacingLeft=20;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="540" height="620" as="geometry" />
        </mxCell>

        <mxCell id="fail" value="Build fails" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#67000d;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="lane">
          <mxGeometry x="160" y="55" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="fetch" value="fix-build fetches&#xa;existing build" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#172b4d;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="lane">
          <mxGeometry x="160" y="160" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="archcheck" value="All requested&#xa;architectures present?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#6d4c00;spacing=4;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="lane">
          <mxGeometry x="175" y="265" width="190" height="100" as="geometry" />
        </mxCell>

        <mxCell id="archfail" value="Abort -&#xa;missing architectures" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#67000d;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="lane">
          <mxGeometry x="10" y="280" width="130" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sign" value="Run signing and&#xa;verification" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#263b23;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="lane">
          <mxGeometry x="160" y="410" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="optional" value="Optional: import&#xa;and test stages" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#263b23;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;dashed=1;" vertex="1" parent="lane">
          <mxGeometry x="160" y="510" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Edges in lane -->
        <mxCell id="ef1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#46556b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="lane" source="fail" target="fetch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#46556b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="lane" source="fetch" target="archcheck">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef-no" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;" edge="1" parent="lane" source="archcheck" target="archfail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef-yes" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Arial;fontSize=14;" edge="1" parent="lane" source="archcheck" target="sign">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ef4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#46556b;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="lane" source="sign" target="optional">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Separate release workflow box -->
        <mxCell id="release-box" value="Release workflow&#xa;(check separately)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#4a235a;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="640" y="200" width="230" height="80" as="geometry" />
        </mxCell>

        <mxCell id="release-note" value="A successful fix-build&#xa;does NOT publish a release.&#xa;Verify the release workflow&#xa;and its validations separately." style="text;html=1;fontFamily=Arial;fontSize=13;fontColor=#999999;fontStyle=2;align=left;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="640" y="300" width="230" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
