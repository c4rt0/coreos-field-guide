<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example: generated config.xml for a multibranch pipeline job

  Illustrative serialization of the public seed job's DSL, not a config dump
  from a running Jenkins instance. Jenkins stores job configuration under
  $JENKINS_HOME/jobs/<name>/config.xml. Plugin versions can add or change fields.

  Public sources:
    https://github.com/coreos/coreos-ci/blob/main/jobs/seed-github-ci.Jenkinsfile
    https://github.com/jenkinsci/cloudbees-folder-plugin/blob/master/src/main/java/com/cloudbees/hudson/plugins/folder/computed/PeriodicFolderTrigger.java
    https://github.com/jenkinsci/workflow-multibranch-plugin/blob/master/src/main/java/org/jenkinsci/plugins/workflow/multibranch/SCMBinder.java

  This example uses the public "coreos/afterburn" repository. The credential
  ID is a generic placeholder, not a credential value or a deployment's ID.
  See README.md for the current CoreOS CI guide.

  Sections are annotated with which DSL block generates them.
-->
<org.jenkinsci.plugins.workflow.multibranch.WorkflowMultiBranchProject>

  <!--
    Generated by: branchSources { branchSource { ... } }
    This is the heart of the job config - where to look, what to discover,
    when to build.
  -->
  <sources class="jenkins.branch.MultiBranchProject$BranchSourceList">
    <data>
      <jenkins.branch.BranchSource>

        <!--
          Generated by: source { github { ... } }
          The SCM source - which GitHub repo to watch.
        -->
        <source class="org.jenkinsci.plugins.github_branch_source.GitHubSCMSource">
          <!-- Synthetic source ID: keep stable across seed updates. -->
          <id>11111111-1111-4111-8111-111111111111</id>
          <repoOwner>coreos</repoOwner>
          <repository>afterburn</repository>
          <repositoryUrl></repositoryUrl>
          <configuredByUrl>false</configuredByUrl>
          <credentialsId>example-github-scan-credential</credentialsId>

          <!--
            Generated by: traits { ... }
            Controls WHICH branches and PRs the job discovers.
          -->
          <traits>
            <!--
              gitHubBranchDiscovery { strategyId(1) }
              strategyId=1: only branches NOT filed as PRs
              (bit 0 set, bit 1 clear - avoids building both branch and its PR)
            -->
            <org.jenkinsci.plugins.github__branch__source.BranchDiscoveryTrait>
              <strategyId>1</strategyId>
            </org.jenkinsci.plugins.github__branch__source.BranchDiscoveryTrait>

            <!--
              gitHubPullRequestDiscovery { strategyId(1) }
              strategyId=1: test PRs merged with target branch
            -->
            <org.jenkinsci.plugins.github__branch__source.OriginPullRequestDiscoveryTrait>
              <strategyId>1</strategyId>
            </org.jenkinsci.plugins.github__branch__source.OriginPullRequestDiscoveryTrait>

            <!--
              gitHubForkDiscovery { strategyId(1); trust { gitHubTrustContributors() } }
              strategyId=1: test fork PRs merged with target
              TrustContributors selects whether the fork revision is trusted
              for loading .cci.jenkinsfile. Untrusted fork code can still be
              tested using the trusted target-branch pipeline definition.
              This is not a blanket CI ban or isolation of checked-out PR code.
            -->
            <org.jenkinsci.plugins.github__branch__source.ForkPullRequestDiscoveryTrait>
              <strategyId>1</strategyId>
              <trust class="org.jenkinsci.plugins.github_branch_source.ForkPullRequestDiscoveryTrait$TrustContributors"/>
            </org.jenkinsci.plugins.github__branch__source.ForkPullRequestDiscoveryTrait>
          </traits>
        </source>

        <!--
          Generated by: strategy { allBranchesSame { props { ... } } }
          Branch properties applied to ALL discovered branches.
        -->
        <strategy class="jenkins.branch.DefaultBranchPropertyStrategy">
          <properties class="java.util.Arrays$ArrayList">
            <a class="jenkins.branch.BranchProperty-array">
              <!--
                durabilityHint { hint('PERFORMANCE_OPTIMIZED') }
                Reduces persistence overhead at the cost of crash durability;
                not a guarantee that every restart loses the pipeline.
              -->
              <org.jenkinsci.plugins.workflow.multibranch.DurabilityHintBranchProperty>
                <hint>PERFORMANCE_OPTIMIZED</hint>
              </org.jenkinsci.plugins.workflow.multibranch.DurabilityHintBranchProperty>
            </a>
          </properties>
        </strategy>

        <!--
          Generated by: buildStrategies { buildChangeRequests { ... } }
          Controls WHEN to trigger builds (not what to discover).
        -->
        <buildStrategies>
          <!--
            buildChangeRequests { ignoreTargetOnlyChanges(true) }
            Don't rebuild when only the target branch moved forward.
            ignoreUntrustedChanges(false) does not suppress all untrusted PRs.
          -->
          <jenkins.branch.buildstrategies.basic.ChangeRequestBuildStrategyImpl>
            <ignoreTargetOnlyChanges>true</ignoreTargetOnlyChanges>
            <ignoreUntrustedChanges>false</ignoreUntrustedChanges>
          </jenkins.branch.buildstrategies.basic.ChangeRequestBuildStrategyImpl>
        </buildStrategies>

      </jenkins.branch.BranchSource>
    </data>
  </sources>

  <!--
    Generated by: factory { workflowBranchProjectFactory { scriptPath(...) } }
    Tells Jenkins which file in the repo is the pipeline script.
  -->
  <factory class="org.jenkinsci.plugins.workflow.multibranch.WorkflowBranchProjectFactory">
    <scriptPath>.cci.jenkinsfile</scriptPath>
  </factory>

  <!--
    Generated by: orphanedItemStrategy { discardOldItems() }
    Clean up jobs for deleted branches/PRs.
  -->
  <orphanedItemStrategy class="com.cloudbees.hudson.plugins.folder.computed.DefaultOrphanedItemStrategy">
    <pruneDeadBranches>true</pruneDeadBranches>
    <daysToKeep>-1</daysToKeep>
    <numToKeep>-1</numToKeep>
  </orphanedItemStrategy>

  <!--
    Generated by: triggers { periodicFolderTrigger { interval('1440') } }
    DSL interval('1440') is in minutes; the serialized interval is milliseconds:
    1440 * 60 * 1000 = 86400000 (one day).
    The plugin's cron wakes periodically and checks elapsed time; other events
    may also cause indexing. This is not a fixed once-a-day cron schedule.
  -->
  <triggers>
    <com.cloudbees.hudson.plugins.folder.computed.PeriodicFolderTrigger>
      <spec>H H/4 * * *</spec>
      <interval>86400000</interval>
    </com.cloudbees.hudson.plugins.folder.computed.PeriodicFolderTrigger>
  </triggers>

</org.jenkinsci.plugins.workflow.multibranch.WorkflowMultiBranchProject>
