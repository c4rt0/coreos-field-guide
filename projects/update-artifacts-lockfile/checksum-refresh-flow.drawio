<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.7.0" type="device">
  <diagram id="checksum-refresh-flow" name="Checksum Refresh">
    <mxGraphModel dx="1100" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Artifact checksum refresh" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=26;fontStyle=1;fontColor=#172554;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1020" height="45" as="geometry" />
        </mxCell>
        <mxCell id="3" value="A dependency version change and its new content fingerprint are reviewed together." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=17;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="75" width="1020" height="40" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;b&gt;1. Version changes&lt;/b&gt;&lt;br&gt;Renovate updates the artifact URL in the lockfile." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="210" height="170" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;2. Helper runs&lt;/b&gt;&lt;br&gt;Reads the affected lockfile paths passed by the update workflow." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="170" width="210" height="170" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;3. Checksum refreshes&lt;/b&gt;&lt;br&gt;Fetches the declared artifact, computes SHA-256, and updates its entry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1f2937;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="170" width="210" height="170" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;4. Change is reviewed&lt;/b&gt;&lt;br&gt;Normal pull-request checks and review decide whether it is accepted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2937;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="170" width="210" height="170" as="geometry" />
        </mxCell>
        <mxCell id="8" value="This helper refreshes artifact checksums; RPM dependency-lockfile maintenance is a separate workflow." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cbd5e1;fontColor=#334155;fontSize=16;fontFamily=Arial;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="1050" height="65" as="geometry" />
        </mxCell>
        <mxCell id="9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="6">
