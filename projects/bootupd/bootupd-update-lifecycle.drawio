<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.7.0">
  <diagram name="bootupd runtime update lifecycle">
    <mxGraphModel dx="1020" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="500" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="bootupd: from OS payload to boot disk" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#183153;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="960" height="40" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Update tool, not the bootloader. OS delivery and disk activation are separate operations." style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#52708b;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="960" height="40" as="geometry" />
        </mxCell>
        <mxCell id="4" value="1. Booted OS payload&#xa;OS image delivers files +&#xa;update metadata under /usr" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1b2a41;fontFamily=Helvetica;fontSize=20;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="130" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="5" value="2. Inspect status&#xa;sudo bootupctl status&#xa;Installed vs. available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1b2a41;fontFamily=Helvetica;fontSize=20;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="370" y="130" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="6" value="3. Apply available update&#xa;sudo bootupctl update&#xa;or distro-enabled service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1b2a41;fontFamily=Helvetica;fontSize=20;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="710" y="130" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="7" value="4. EFI / boot disk&#xa;Write shim / GRUB files&#xa;or BIOS bootloader data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1b2a41;fontFamily=Helvetica;fontSize=20;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="710" y="330" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="8" value="5. Next boot&#xa;Firmware starts bootloader&#xa;Bootloader loads kernel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1b2a41;fontFamily=Helvetica;fontSize=20;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="370" y="330" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="9" value="OS rollback is not a&#xa;bootloader rollback.&#xa;Keep a recovery plan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontColor=#1b2a41;fontFamily=Helvetica;fontSize=20;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="330" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="10" value="Automatic-update policy and safety vary by distribution, boot method, and packaged version." style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=18;fontColor=#52708b;" vertex="1" parent="1">
          <mxGeometry x="30" y="460" width="960" height="30" as="geometry" />
        </mxCell>
        <mxCell id="11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeColor=#52677f;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
