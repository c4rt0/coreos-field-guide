<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" compressed="false">
  <diagram id="kola-test-flow" name="Kola Test Flow">
    <mxGraphModel dx="900" dy="1100" grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="900" pageHeight="1100" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="COSA build in workspace&#xa;or cosa buildfetch" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#172b4d;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Native Go tests&#xa;mantle/kola/tests" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#172b4d;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="330" y="30" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="4" value="External tests&#xa;config repo tests/kola" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#172b4d;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="630" y="30" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="5" value="kola run PATTERN&#xa;--tag, --platform, arch, distro filters" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#263b23;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="150" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="6" value="kola-denylist.yaml&#xa;scoped by stream, arch, platform" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#4b3500;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="260" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="7" value="Denylist entry&#xa;matches?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#4b3500;spacing=4;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="370" y="260" width="160" height="100" as="geometry" />
        </mxCell>

        <mxCell id="8" value="Skipped&#xa;until snooze date" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#67000d;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="650" y="270" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="9" value="Boot VM from the image&#xa;Ignition from config.bu or config.ign" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#263b23;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="420" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="10" value="Optional --oscontainer:&#xa;rpm-ostree rebase onto OCI image, reboot" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#4b3500;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="540" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="11" value="Run test&#xa;systemd unit for external tests" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#263b23;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="660" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="12" value="Pass?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#4b3500;spacing=4;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="390" y="790" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="13" value="PASS" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#263b23;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="930" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="14" value="FAIL or warning&#xa;logs in tmp/kola/TEST:" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#67000d;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="500" y="930" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#46556b;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="2" target="5">
          <mxGeometry relative="1" as="geometry" />
