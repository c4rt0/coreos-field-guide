<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" compressed="false">
  <diagram id="disk-image-nudging" name="FCOS Disk Image Nudging Sequence">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Participants -->
        <mxCell id="p1" value="FCOS Component&#xa;build" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#172b4d;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="Konflux&#xa;Build Service" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#263b23;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="Renovate" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#4b3500;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="410" y="20" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="Disk-images&#xa;repository" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#3b1f54;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="600" y="20" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="Pipelines&#xa;as Code" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#4b3500;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="790" y="20" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="l1" style="endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="100" y="80" as="sourcePoint" /><mxPoint x="100" y="680" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l2" style="endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="290" y="80" as="sourcePoint" /><mxPoint x="290" y="680" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l3" style="endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="480" y="80" as="sourcePoint" /><mxPoint x="480" y="680" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l4" style="endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="670" y="80" as="sourcePoint" /><mxPoint x="670" y="680" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="l5" style="endArrow=none;dashed=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="860" y="80" as="sourcePoint" /><mxPoint x="860" y="680" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- Messages -->
        <mxCell id="m1" value="Build publishes new image digest" style="html=1;fontFamily=Arial;fontSize=13;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#46556b;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="100" y="120" as="sourcePoint" /><mxPoint x="290" y="120" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m2" value="Read build-nudges-ref&#xa;and stream ConfigMap" style="html=1;fontFamily=Arial;fontSize=13;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#46556b;strokeWidth=2;curved=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="290" y="180" as="sourcePoint" /><mxPoint x="290" y="230" as="targetPoint" /><Array as="points"><mxPoint x="350" y="205" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="m3" value="Start dependency update" style="html=1;fontFamily=Arial;fontSize=13;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#46556b;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="290" y="270" as="sourcePoint" /><mxPoint x="480" y="270" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m4" value="Update pinned digest, open PR" style="html=1;fontFamily=Arial;fontSize=13;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#46556b;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="480" y="340" as="sourcePoint" /><mxPoint x="670" y="340" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m5" value="Pull-request event" style="html=1;fontFamily=Arial;fontSize=13;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#46556b;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="670" y="410" as="sourcePoint" /><mxPoint x="860" y="410" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m6" value="Start PR pipeline" style="html=1;fontFamily=Arial;fontSize=13;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#46556b;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="860" y="470" as="sourcePoint" /><mxPoint x="670" y="470" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="note1" value="Pipeline coverage depends on&#xa;the downstream repository" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontColor=#666666;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="660" y="500" width="220" height="40" as="geometry" />
        </mxCell>

        <mxCell id="m7" value="Push event after merge" style="html=1;fontFamily=Arial;fontSize=13;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#46556b;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="670" y="580" as="sourcePoint" /><mxPoint x="860" y="580" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m8" value="Start push pipeline" style="html=1;fontFamily=Arial;fontSize=13;align=center;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#46556b;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="860" y="640" as="sourcePoint" /><mxPoint x="670" y="640" as="targetPoint" /></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
